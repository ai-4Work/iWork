# 复制为 i-work/.env（该文件已被 .gitignore 忽略）并填入真实值。
# 所有 IWORK_ 前缀的变量都会被 server/config.py 读取；进程环境变量优先于本文件。

# ── LLM ──
IWORK_LLM_PROVIDER=deepseek
IWORK_DEEPSEEK_API_KEY=
IWORK_DEEPSEEK_BASE_URL=https://api.deepseek.com
IWORK_DEFAULT_MODEL=

# ── 数据库（必填，缺失时启动直接报错）──
IWORK_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>

# ── 认证（docs/chapters/18-登录认证模块）──
# JWT 签名密钥。必填且至少 32 字节，不足则启动直接拒绝。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
IWORK_JWT_SECRET=
# access token 有效期（分钟）/ refresh token 有效期（天，滑动续期）
# IWORK_AUTH_ACCESS_TTL_MINUTES=15
# IWORK_AUTH_REFRESH_TTL_DAYS=7
# 连续失败几次锁定 / 锁多久（分钟）/ 轮换宽限期（秒）
# IWORK_AUTH_MAX_FAILED_LOGINS=5
# IWORK_AUTH_LOCKOUT_MINUTES=15
# IWORK_AUTH_REFRESH_GRACE_SECONDS=30

# ── RBAC bootstrap 管理员（docs/chapters/19-权限管理RBAC.md §5.5）──
# 首个管理员账号名。挂 admin 角色（代码里短路成全集），不是"谁先注册谁当管理员"。
IWORK_BOOTSTRAP_ADMIN_USERNAME=admin
# 首个管理员密码。**只在 admin 账号还不存在时必填**，为空则拒绝启动；
# 账号已存在时留空不报错，重启不会被卡住。密码一旦建立不会被种子覆盖。
IWORK_BOOTSTRAP_ADMIN_PASSWORD=

# ── L1 原子记忆（docs/chapters/5-记忆模块）──
# 总开关：false 时不起抽取调度、不召回、不注册 memory_search 工具
IWORK_L1_ENABLED=false
# 抽取/去重用的模型，留空回落到 IWORK_COMPRESSION_MODEL
IWORK_L1_EXTRACTION_MODEL=

# ── L2 场景记忆（docs/chapters/5-记忆模块 第二部分）──
# 总开关：false 时不起整合调度、不注入场景导航、不注册 scene_read 工具。
# 依赖 L1 的产出，因此需要同时开 IWORK_L1_ENABLED=true
IWORK_L2_ENABLED=false
# 整合用的模型，留空依次回落到 IWORK_L1_EXTRACTION_MODEL / IWORK_COMPRESSION_MODEL
IWORK_L2_CONSOLIDATION_MODEL=

# ── MCP 工具密钥 ──
HEFENG_API_KEY=
AMAP_MAPS_API_KEY=
BAIDU_MAP_AK=
